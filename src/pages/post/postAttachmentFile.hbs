<div class="post-page__file-info">
  <span class="post-page__file-name" title="{{name}}">{{name}}</span>
  <span class="post-page__file-size">{{size}}</span>
  <span class="post-page__file-error" data-download-error role="status"></span>
</div>
<button class="post-page__download" type="button" aria-label="Скачать {{name}}"></button>
