<section class="settings subscription" aria-labelledby="subscription-heading">
  {{#if backHref}}<a class="settings__back" href="{{backHref}}" data-link>← {{#if confirmation}}К выбору уровня{{else}}К профилю автора{{/if}}</a>{{/if}}
  <div class="settings__container">
    <h1 class="settings__title" id="subscription-heading">{{heading}}</h1>
    {{#if confirmation}}
      <div class="settings__card subscription__confirmation">
        <p>{{author.name}}</p>
        <p>Уровень «{{confirmation.name}}»</p>
        {{#if upgrade}}<p>Новый уровень заменит «{{currentName}}»</p>{{/if}}
        <p class="subscription__tier subscription__price">{{confirmation.price}} в месяц</p>
        <p class="settings__hint">{{#if upgrade}}Списаний не будет. Дата окончания подписки не изменится{{else}}Тестовая подписка на 30 дней. Списаний не будет{{/if}}.</p>
        <div class="subscription__actions">
          <button class="button button_view_primary tier-button" type="button" disabled>{{#if upgrade}}Повысить уровень{{else}}Подтвердить подписку{{/if}}</button>
          <a class="button button_view_secondary tier-button subscription__back-button" href="{{backHref}}" data-link>Назад</a>
        </div>
      </div>
    {{else}}
      {{#if author}}
        <div class="settings__card subscription__author">
          <img src="{{author.avatar}}" width="32" height="32" alt="" data-avatar>
          <p>{{author.name}}</p>
        </div>
      {{/if}}
      <div class="settings__card subscription__options">
        {{#each tiers}}
          <div class="subscription__tier">
            <div class="subscription-tiers__header">
              <h2 class="subscription-tiers__name" id="subscription-tier-{{@index}}">{{name}}</h2>
              <p>{{price}} в месяц</p>
            </div>
            {{#if current}}
              <p class="settings__hint">Текущий уровень</p>
            {{else}}
              {{#if description}}<p class="subscription__description">{{description}}</p>{{/if}}
              <button class="button {{#if ../upgrade}}button_view_primary{{else}}button_view_secondary{{/if}} tier-button" type="button" data-tier-id="{{id}}"
                aria-describedby="subscription-tier-{{@index}}" aria-pressed="{{#if selected}}true{{else}}false{{/if}}">Выбрать уровень</button>
            {{/if}}
          </div>
        {{/each}}
        {{#if message}}<p role="status">{{message}}</p>{{/if}}
      </div>
    {{/if}}
  </div>
</section>
