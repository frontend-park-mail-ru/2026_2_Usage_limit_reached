<section class="profile" aria-label="Публичный профиль">
  <a class="profile__back" href="{{#if backHref}}{{backHref}}{{else}}/feed{{/if}}" data-link hidden>← Назад</a>
  {{#if message}}
    <div class="profile__summary">
      <p class="{{#if isError}}profile__error{{else}}profile__username{{/if}}" role="status"{{#if loading}} data-loading-delay="{{message}}"{{/if}}>{{message}}</p>
    </div>
  {{else}}
    <div class="profile__summary profile__summary-public">
      <div class="profile__identity">
        <img class="profile__avatar" src="{{avatarUrl}}" alt="Фото профиля" />
        <div class="profile__info">
          <div class="profile__heading">
            <h1 class="profile__name">{{name}}</h1>
            {{#if isAuthor}}<span class="profile__badge">Автор</span>{{/if}}
          </div>
          <p class="profile__username">{{username}}</p>
          {{#if bio}}
            <div class="profile__description">
              {{> profileBio}}
            </div>
          {{/if}}
        </div>
      </div>
      {{#if isAuthor}}
        <div class="profile__public-actions">
          {{#if subscribeHref}}
            <a class="button button_view_primary profile__button" data-subscribe data-link
              {{#if offline}}role="link" aria-disabled="true"{{else}}href="{{subscribeHref}}"{{/if}}>Подписаться</a>
          {{/if}}
          <button class="button {{#if subscribeHref}}button_view_secondary{{else}}button_view_primary button_borderless{{/if}} profile__button" type="button" data-donate hidden>Пожертвовать</button>
        </div>
      {{/if}}
    </div>
    {{#if isAuthor}}
      <section class="profile__posts" aria-labelledby="public-profile-posts">
        <div class="profile__toolbar">
          <h2 class="profile__title" id="public-profile-posts">Посты</h2>
          <div class="profile__sort" data-public-sort></div>
        </div>
        <div data-public-posts></div>
      </section>
      {{> donateDialog}}
    {{/if}}
  {{/if}}
</section>
