{{#if message}}
  <section class="profile" aria-label="Профиль"{{#if loading}} data-profile-loading{{/if}}>
    <div class="profile__summary">
      <p class="{{#if isError}}profile__error{{else}}profile__username{{/if}}" role="status">{{message}}</p>
    </div>
  </section>
{{else}}
<section class="profile" aria-label="Профиль"{{#if offline}} data-offline-copy{{/if}}>
  <div class="profile__summary">
    {{#if profileMissing}}
      <p class="profile__error">Нет сохранённого профиля. Попробуйте обновить страницу позже.</p>
    {{else}}
    <div class="profile__identity">
      <img class="profile__avatar" src="{{avatarUrl}}" alt="Фото профиля" />
      <div class="profile__info">
        <div class="profile__heading">
          <h1 class="profile__name" id="profile-name">{{name}}</h1>
          {{#if hasAuthor}}<span class="profile__badge">Автор</span>{{/if}}
        </div>
        <p class="profile__username">{{username}}</p>
        {{#if hasAuthor}}
{{> profileBio}}
          {{#if offline}}
            {{#unless postsMissing}}
              <p class="profile__post-count">{{postCountLabel}}{{#if hasMorePosts}}. Есть ещё посты, они не загружены.{{/if}}</p>
            {{/unless}}
          {{/if}}
        {{/if}}
      </div>
    </div>
    {{#unless offline}}
    <div class="profile__actions">
      <a class="button button_view_secondary profile__button profile__button-edit" href="/settings" data-link>Редактировать профиль</a>
      <a class="button button_view_secondary profile__button profile__button-donations" href="/donations" data-link>Пожертвования</a>
    </div>
    {{/unless}}
    {{/if}}
  </div>

  {{#unless offline}}
    {{#if needsPayout}}
      <section class="profile__payout" aria-labelledby="profile-payout-title">
        <div class="profile__payout-content">
          <h2 class="profile__payout-title" id="profile-payout-title">Настройте приём пожертвований</h2>
          <p class="profile__payout-text">Посты можно публиковать сразу. Чтобы получать пожертвования, настройте оплату</p>
        </div>
        <a class="button button_view_primary button_borderless profile__payout-button" href="/settings" data-link>Настроить оплату</a>
      </section>
    {{/if}}
  {{/unless}}

  {{#if showPosts}}
  <section class="profile__posts" aria-label="Публикации">
    {{#if offline}}
      <div class="profile__toolbar">
        <h2 class="profile__title">Посты</h2>
      </div>
      {{#if postsMissing}}
        <p class="profile__error">Нет сохранённых постов. Попробуйте обновить страницу позже.</p>
      {{else}}
        {{> postsList}}
      {{/if}}
    {{else}}
      <div class="profile__toolbar">
        {{> tabs id="profile-tabs" panelId="profile-panel" label="Публикации" items=tabs}}
        <div class="profile__controls">
          <a class="button button_view_accent button_borderless profile__button profile__button-add" href="/posts/new" data-link data-create-post>
            <span class="profile__button-icon" aria-hidden="true"><img src="/assets/profile/plus.svg" alt="" /></span>
            Создать пост
          </a>
          <div class="profile__sort" data-profile-sort></div>
        </div>
      </div>
      <div class="profile__panel" id="profile-panel" role="tabpanel" data-profile-panel></div>
      {{> confirmDialog id="draft-delete" title="Удалить черновик?" text="Черновик исчезнет из списка. Восстановить его не получится"
          errorTitle="Не удалось удалить" cancelLabel="Отмена" confirmLabel="Удалить черновик"}}
      {{> confirmDialog id="post-delete" title="Удалить пост?" text="Пост исчезнет из профиля. Восстановить его не получится"
          errorTitle="Не удалось удалить пост" cancelLabel="Отмена" confirmLabel="Удалить"}}
    {{/if}}
  </section>
  {{else}}
    <section class="profile__author-invite" aria-labelledby="profile-author-title">
      <div class="profile__author-content">
        <h2 class="profile__author-title" id="profile-author-title">Станьте автором и публикуйте посты</h2>
        <p class="profile__author-text">Делитесь идеями, историями и знаниями с читателями. Авторам доступны публикация постов, статистика и другие возможности.</p>
        <a class="button button_view_primary button_borderless profile__button profile__button-become-author" href="/become-author" data-link>Стать автором</a>
      </div>
      <img class="profile__author-image" src="/assets/profile/img-author.svg" alt="" />
    </section>
  {{/if}}
</section>
{{/if}}
