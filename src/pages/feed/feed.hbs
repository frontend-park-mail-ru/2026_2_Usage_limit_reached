<section class="feed" aria-labelledby="feed-title">
  <div class="feed__toolbar">
    <h1 class="feed__title" id="feed-title">Лента</h1>
    <form class="feed__search" role="search" data-feed-search>
      <button type="submit" aria-label="Найти посты">
        <img src="/assets/feed/search.svg" width="20" height="20" alt="">
      </button>
      <input type="search" name="q" aria-label="Поиск по постам" placeholder="Поиск по постам">
      <button type="reset" aria-label="Очистить поиск" hidden>×</button>
    </form>
    <div class="feed__tools">
      <button class="feed__filters-button" type="button" popovertarget="feed-filters">
        <img src="/assets/feed/filters.svg" width="20" height="20" alt="">Фильтры
      </button>
      <div class="feed__sort" data-public-sort></div>
      <form class="feed__filters" id="feed-filters" popover aria-label="Фильтры">
        <details class="feed__topic-section">
          <summary>Тема <span data-topic-value></span></summary>
          <div class="feed__attachment-options" role="radiogroup" aria-label="Тема">
            <label><input type="radio" name="tag" value="" checked>Все темы <span aria-hidden="true">✓</span></label>
            {{#each topics}}
              <label><input type="radio" name="tag" value="{{this}}">{{this}} <span aria-hidden="true">✓</span></label>
            {{/each}}
          </div>
        </details>
        <details class="feed__attachment-section" open>
          <summary>Вложения <span data-attachment-value></span></summary>
          <div class="feed__attachment-options" role="radiogroup" aria-labelledby="feed-attachments" aria-describedby="feed-attachments-hint">
            <span id="feed-attachments">Вложения</span>
            <small id="feed-attachments-hint">Обложки постов не учитываются. Доступность фильтра определяет сервер.</small>
            {{#each attachments}}
              <label>
                <input type="radio" name="attachment_type" value="{{value}}"{{#if selected}} checked{{/if}}>
                {{label}}<span aria-hidden="true">✓</span>
              </label>
            {{/each}}
          </div>
        </details>
        <div class="feed__filter-actions">
          <button class="button button_borderless" type="reset">Сбросить</button>
          <button class="button button_view_primary" type="submit">Применить</button>
        </div>
      </form>
    </div>
  </div>
  <dialog class="feed__filter-sheet" id="feed-filter-sheet" aria-labelledby="feed-filter-title">
    <header>
      <h2 id="feed-filter-title">Фильтры</h2>
      <button class="feed__filter-close" type="button" aria-label="Закрыть фильтры" autofocus></button>
    </header>
  </dialog>
  <div class="feed__topics" role="group" aria-label="Темы постов">
    <button class="button button_borderless" type="button" data-topic="" aria-pressed="true">Все темы</button>
    {{#each topics}}
      <button class="button button_borderless" type="button" data-topic="{{this}}" aria-pressed="false">{{this}}</button>
    {{/each}}
  </div>
  <div data-public-posts></div>
</section>
