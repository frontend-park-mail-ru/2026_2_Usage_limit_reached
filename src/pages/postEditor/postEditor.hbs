{{#if message}}
  <section class="post-editor" aria-label="Редактор поста">
    <p class="{{#if isError}}post-editor__load-error{{else}}post-editor__loading{{/if}}" role="status"{{#if loading}} data-loading-delay="{{message}}"{{/if}}>{{message}}</p>
  </section>
{{else if unavailable}}
  <section class="post-editor" aria-labelledby="post-editor-unavailable">
    <a class="post-editor__back post-editor__back-page" href="/profile" data-link>← Мой профиль</a>
    <div class="post-editor__card post-editor__card-unavailable">
      <h1 class="post-editor__unavailable-title" id="post-editor-unavailable">Публикация недоступна</h1>
      <p class="post-editor__unavailable-text">Автор удалил публикацию или ссылка больше не работает. Вернитесь в профиль автора</p>
    </div>
  </section>
{{else}}
<section class="post-editor post-editor_form" aria-labelledby="post-editor-heading">
  <header class="post-editor__bar">
    <a class="post-editor__back" href="{{backHref}}" data-link data-editor-exit>{{backLabel}}</a>
    <span data-editor-settings-back hidden>
      <button class="post-editor__back post-editor__back-button" type="button">← Назад</button>
    </span>
    <h1 class="post-editor__heading" id="post-editor-heading" tabindex="-1">{{heading}}</h1>
  </header>

  <form class="post-editor__form" id="post-editor-form" novalidate>
    {{> alert className="post-editor__alert"}}
    <button class="button button_view_secondary post-editor__refresh" type="button" data-refresh-post hidden>Обновить пост</button>
    <div class="post-editor__card" data-editor-content>
      {{> alert className="post-editor__attachments-alert" title="Вложения ещё не готовы"}}
      <textarea
        class="post-editor__title"
        name="title"
        rows="1"
        placeholder="Заголовок поста"
        aria-label="Заголовок поста"
        aria-describedby="post-editor-title-error"
        autocomplete="off"
      >{{title}}</textarea>
      <p class="form-field__error post-editor__title-error" id="post-editor-title-error" data-error-for="title" aria-live="polite"></p>
      {{#> richEditor id="post-editor-body" name="body" label="Текст поста" placeholder="Начните писать…" errorPlaceholder="Текст поста"}}
        <div class="action-menu rich-editor__attachment-slot" data-attachments>
          <button class="action-menu__button post-editor__attachment-add" type="button" aria-label="Добавить вложение" aria-haspopup="menu" aria-expanded="false" aria-controls="post-attachments-menu"></button>
          <div class="action-menu__list post-editor__attachment-menu" id="post-attachments-menu" role="menu" aria-label="Добавить вложение" hidden>
            <button class="action-menu__item" type="button" role="menuitem" tabindex="-1" data-action="image">Изображение</button>
            <button class="action-menu__item" type="button" role="menuitem" tabindex="-1" data-action="video">Видео</button>
            <button class="action-menu__item" type="button" role="menuitem" tabindex="-1" data-action="audio">Аудио</button>
            <button class="action-menu__item" type="button" role="menuitem" tabindex="-1" data-action="file">Файл</button>
          </div>
          <input type="file" hidden>
        </div>
      {{/richEditor}}
      <template data-attachment-template>
        <div class="post-editor__attachment" data-attachment contenteditable="false">
          <span class="post-editor__attachment-name" data-attachment-name></span>
          <button class="post-editor__attachment-close" type="button" aria-label="Убрать файл"></button>
          <div class="post-editor__attachment-message" role="status"></div>
          <button class="post-editor__attachment-retry" type="button" hidden>Повторить</button>
        </div>
      </template>
      <p class="post-editor__status" data-editor-status role="status">{{statusText}}</p>
    </div>
    <div class="post-editor__settings" data-editor-settings>
      <section class="post-access" aria-labelledby="post-access-heading">
        <h2 class="post-cover__heading" id="post-access-heading">Доступ к посту</h2>
        {{> select id="post-access-tier" name="post-access-tier" label="При публикации"}}
        <p class="post-cover__hint" data-post-access-hint></p>
        <p class="post-cover__status" data-post-access-status role="status"></p>
        <button class="button button_view_secondary" type="button" data-post-access-retry hidden>Повторить</button>
        <div class="post-access__schedule" data-access-schedule>
          <p class="post-cover__hint" data-stage-zone hidden></p>
          <p class="post-cover__status post-cover__status_error" data-schedule-error role="status"></p>
          <div data-access-stages></div>
          <button class="button button_view_secondary" type="button" data-stage-add>Добавить этап</button>
          <template data-access-stage>
            <details class="post-access__stage">
              <summary>
                <time class="post-cover__hint"></time>
                <span></span>
              </summary>
              <div class="post-access__stage-fields">
                <div class="post-access__stage-dates">
                  <label>Дата<input class="form-field__input" type="date" required></label>
                  <label>Время<input class="form-field__input" type="time" required></label>
                </div>
                <p class="post-cover__status post-cover__status_error" data-stage-date-error role="status"></p>
                <label>Доступ с этого этапа<select class="form-field__input select__input"></select></label>
                <div class="post-access__stage-actions">
                  <button class="button button_view_secondary" type="button" data-stage-done>Готово</button>
                  <button class="post-cover__remove" type="button" data-stage-delete>Удалить</button>
                </div>
              </div>
            </details>
          </template>
        </div>
        <section class="post-access__stage-fields publication-end" data-publication-end aria-labelledby="publication-end-heading">
          <h3 class="post-cover__heading" id="publication-end-heading">Завершение публикации</h3>
          <p class="post-cover__hint">В это время пост переместится в черновики</p>
          <details>
            <summary class="form-field__input select__input">Указать дату и время</summary>
            <div class="publication-end__fields">
              <div class="post-access__stage-dates">
                <label>Дата<input class="form-field__input" type="date" aria-describedby="publication-end-error"></label>
                <label>Время<input class="form-field__input" type="time" aria-describedby="publication-end-error"></label>
              </div>
              <p class="post-cover__status post-cover__status_error" id="publication-end-error" data-publication-end-error role="status"></p>
              <div class="post-access__stage-actions">
                <button class="button button_view_secondary" type="button" data-end-done>Готово</button>
                <button class="post-cover__remove" type="button" data-end-clear>Убрать дату</button>
              </div>
            </div>
          </details>
        </section>
      </section>
      <section class="post-cover" data-cover aria-labelledby="post-cover-heading">
        <h2 class="post-cover__heading" id="post-cover-heading">Обложка поста</h2>
        <img class="post-cover__preview" data-cover-preview alt="Обложка поста" hidden>
        <button class="button button_view_secondary post-cover__choose" type="button" data-cover-choose>Добавить обложку</button>
        <button class="post-cover__remove" type="button" data-cover-remove hidden>Удалить обложку</button>
        <p class="post-cover__status" data-cover-status role="status"></p>
        <p class="post-cover__hint">Обложка будет видна в ленте, если вы её добавите</p>
        <input type="file" hidden>
      </section>
    </div>
  </form>

  <div class="post-editor__actions" role="group" aria-label="Действия с постом">
    {{#if isPublished}}
      <button class="button button_view_primary post-editor__button" type="submit" form="post-editor-form" data-intent="save">{{saveLabel}}</button>
    {{else}}
      <button class="button button_view_secondary post-editor__button" type="submit" form="post-editor-form" data-intent="save">{{saveLabel}}</button>
      <button class="button button_view_primary post-editor__button" type="submit" form="post-editor-form" data-intent="publish">Опубликовать</button>
    {{/if}}
    <span class="post-editor__next" data-editor-settings-next hidden>
      <button class="button {{#if isPublished}}button_view_secondary{{else}}button_view_primary{{/if}} post-editor__button" type="button">
        {{#if isPublished}}Настройки{{else}}Далее{{/if}}
      </button>
    </span>
  </div>

  {{> linkDialog}}

  {{#> modal id="leave-dialog" title=leaveTitle className="post-editor__leave"}}
    <p class="post-editor__leave-text">Изменения ещё не сохранены. Сохраните их, чтобы продолжить позже</p>
    <div class="post-editor__leave-actions">
      <button class="button button_view_primary post-editor__leave-button" type="button" data-leave="save">Сохранить и выйти</button>
      <button class="button button_view_secondary post-editor__leave-button" type="button" data-modal-close>Продолжить писать</button>
      <button class="post-editor__leave-link" type="button" data-leave="discard">Выйти без сохранения</button>
    </div>
  {{/modal}}
</section>
{{/if}}
