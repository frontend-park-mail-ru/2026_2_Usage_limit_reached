{{#> modal id="donate-dialog" title="Пожертвовать" className="donate-dialog"}}
  <div class="donate-dialog__step" data-donate-step="form">
    {{> alert title="Не удалось отправить пожертвование" className="donate-dialog__error"}}
    <div class="donate-dialog__author">
      <img class="donate-dialog__avatar" alt="" data-donate-avatar />
      <div class="donate-dialog__author-info">
        <p class="donate-dialog__name" data-donate-name></p>
        <p class="donate-dialog__username" data-donate-username></p>
      </div>
    </div>
    <form class="donate-dialog__form" novalidate>
      <div class="form-field">
        <label class="form-field__label" for="donate-amount">Сумма, ₽</label>
        <input class="form-field__input" id="donate-amount" name="amount" type="text" inputmode="numeric" maxlength="9" autocomplete="off" aria-describedby="donate-amount-hint donate-amount-error" data-donate-focus />
        <p class="form-field__hint" id="donate-amount-hint">Любая сумма от 1 ₽</p>
        <p class="form-field__error" id="donate-amount-error" data-error-for="amount" aria-live="polite"></p>
      </div>
      <div class="donate-dialog__presets" role="group" aria-label="Быстрый выбор суммы">
        <button class="button button_view_secondary donate-dialog__preset" type="button" data-amount="100" aria-pressed="false">100 ₽</button>
        <button class="button button_view_secondary donate-dialog__preset" type="button" data-amount="500" aria-pressed="false">500 ₽</button>
        <button class="button button_view_secondary donate-dialog__preset" type="button" data-amount="1000" aria-pressed="false">1&nbsp;000 ₽</button>
      </div>
      <div class="form-field">
        <label class="form-field__label" for="donate-message">Личное сообщение · необязательно</label>
        <textarea class="form-field__input form-field__input_type_textarea" id="donate-message" name="message" rows="3" aria-describedby="donate-message-hint donate-message-error"></textarea>
        <p class="form-field__hint" id="donate-message-hint">Максимальная длина сообщения — 200 символов</p>
        <p class="form-field__error" id="donate-message-error" data-error-for="message" aria-live="polite"></p>
      </div>
      <button class="button button_view_primary donate-dialog__button" type="submit">Продолжить</button>
    </form>
    <p class="donate-dialog__note">Пожертвование не оформляет подписку</p>
  </div>

  <div class="donate-dialog__step" data-donate-step="confirm" hidden>
    <p class="donate-dialog__subtitle">Проверьте данные перед отправкой</p>
    <div class="donate-dialog__author">
      <img class="donate-dialog__avatar" alt="" data-donate-avatar />
      <div class="donate-dialog__author-info">
        <p class="donate-dialog__name" data-donate-name></p>
        <p class="donate-dialog__username" data-donate-username></p>
      </div>
    </div>
    <p class="donate-dialog__amount" data-donate-amount></p>
    <div class="donate-dialog__message" data-donate-message-box>
      <p class="donate-dialog__message-label">Личное сообщение автору</p>
      <p class="donate-dialog__message-text" data-donate-message></p>
    </div>
    <div class="donate-dialog__actions">
      <button class="button button_view_secondary donate-dialog__button donate-dialog__button_type_back" type="button" data-donate-back>Назад</button>
      <button class="button button_view_primary donate-dialog__button donate-dialog__button_type_send" type="button" data-donate-send data-donate-focus></button>
    </div>
  </div>

  <div class="donate-dialog__step donate-dialog__step_type_success" data-donate-step="success" hidden>
    <span class="donate-dialog__check" aria-hidden="true"></span>
    <p class="donate-dialog__success-title" role="status">Пожертвование отправлено</p>
    <p class="donate-dialog__summary" data-donate-summary></p>
    <p class="donate-dialog__note" data-donate-success-note>Автор увидит ваше личное сообщение</p>
    <button class="button button_view_primary donate-dialog__button" type="button" data-modal-close data-donate-focus>Вернуться к посту</button>
  </div>
{{/modal}}
