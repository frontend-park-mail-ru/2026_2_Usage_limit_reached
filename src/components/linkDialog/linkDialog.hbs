{{#> modal id="link-dialog" title="Добавить ссылку" className="link-dialog"}}
  <form class="link-dialog__form" novalidate>
    {{> formField id="link-dialog-text" name="text" label="Текст ссылки" type="text" autocomplete="off"}}
    {{> formField id="link-dialog-url" name="url" label="Адрес ссылки" type="url" autocomplete="off" placeholder="https://"}}
    <div class="link-dialog__actions">
      <button class="button button_view_secondary link-dialog__button_type_cancel" type="button" data-modal-close>Отмена</button>
      <button class="button button_view_primary link-dialog__button_type_submit" type="submit" disabled>Вставить ссылку</button>
    </div>
  </form>
{{/modal}}
