{{#if message}}
  <p class="{{#if isError}}posts-list__error{{else}}posts-list__loading{{/if}}" role="status">{{message}}</p>
{{else if isEmpty}}
  {{#if isDrafts}}
    <div class="posts-list__empty posts-list__empty-drafts">
      <h3 class="posts-list__empty-title">Черновиков пока нет</h3>
      <p class="posts-list__empty-text">Вы можете создать пост и сохранить его, как черновик, чтобы вернуться к нему позднее</p>
      <a class="button button_view_accent button_borderless posts-list__empty-button" href="/posts/new" data-link>Создать черновик</a>
    </div>
  {{else}}
    <div class="posts-list__empty posts-list__empty-posts">
      <div class="posts-list__empty-content">
        <h3 class="posts-list__empty-title">Создайте первый пост</h3>
        <p class="posts-list__empty-text">Расскажите о себе или поделитесь идеей<br>После публикации пост появится здесь</p>
        {{#unless offline}}
          <a class="button button_view_primary button_borderless posts-list__empty-button" href="/posts/new" data-link>Создать пост</a>
        {{/unless}}
      </div>
      <img class="posts-list__empty-image" src="/assets/profile/img-author.svg" alt="" />
    </div>
  {{/if}}
{{else}}
  <div class="posts-list__grid" data-posts-grid>
    {{#each cards}}
      {{> postCard}}
    {{/each}}
  </div>
  <div class="posts-list__more" data-posts-more{{#unless hasMore}} hidden{{/unless}}>
    <p class="posts-list__more-text" role="status" data-posts-more-text></p>
    <button class="button button_view_secondary posts-list__retry" type="button" data-posts-retry hidden>Повторить</button>
  </div>
{{/if}}
