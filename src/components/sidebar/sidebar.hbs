<nav class="sidebar" aria-label="Основная навигация">
  <div class="sidebar__top">
    <a class="sidebar__logo-link" href="/" data-link aria-label="Лента">
      <img class="sidebar__logo" src="/assets/sidebar/logo.svg" alt="">
    </a>
    <div class="sidebar__items">
      <div class="sidebar__unavailable" tabindex="0" role="group" aria-label="Поиск" aria-describedby="sidebar-search-hint">
        <button class="sidebar__item sidebar__item-search" type="button" disabled aria-label="Поиск">
          <span class="sidebar__icon sidebar__icon-search" aria-hidden="true"></span>
        </button>
        <span class="sidebar__hint" id="sidebar-search-hint" role="tooltip" hidden>Будет доступно позже</span>
      </div>
      <div class="sidebar__unavailable" tabindex="0" role="group" aria-label="Уведомления" aria-describedby="sidebar-notification-hint">
        <button class="sidebar__item sidebar__item-notification" type="button" disabled aria-label="Уведомления">
          <span class="sidebar__icon sidebar__icon-notification" aria-hidden="true"></span>
        </button>
        <span class="sidebar__hint" id="sidebar-notification-hint" role="tooltip" hidden>Будет доступно позже</span>
      </div>
      <div class="sidebar__unavailable" tabindex="0" role="group" aria-label="Подписки" aria-describedby="sidebar-subscribes-hint">
        <button class="sidebar__item sidebar__item-subscribes" type="button" disabled aria-label="Подписки">
          <span class="sidebar__icon sidebar__icon-subscribes" aria-hidden="true"></span>
        </button>
        <span class="sidebar__hint" id="sidebar-subscribes-hint" role="tooltip" hidden>Будет доступно позже</span>
      </div>
    </div>
  </div>
  <div class="sidebar__bottom">
    <button class="sidebar__item sidebar__item-profile" type="button" aria-label="Профиль" aria-haspopup="menu" aria-expanded="false" aria-controls="profile-menu">
      <img class="sidebar__profile-icon" src="/assets/sidebar/profile.svg" alt="" aria-hidden="true"{{#if avatarUrl}} hidden{{/if}}>
      <img class="sidebar__avatar"{{#if avatarUrl}} src="{{avatarUrl}}"{{/if}} alt="" aria-hidden="true"{{#unless avatarUrl}} hidden{{/unless}}>
    </button>
    {{> profileMenu className="sidebar__profile-menu"}}
  </div>
</nav>
{{> confirmDialog id="logout-confirm" title="Выйти из аккаунта?" hideSubject=true
    text="Вы выйдете из аккаунта на этом устройстве. Чтобы продолжить работу, войдите снова"
    errorTitle="Не удалось выйти" cancelLabel="Отмена" confirmLabel="Выйти"}}
