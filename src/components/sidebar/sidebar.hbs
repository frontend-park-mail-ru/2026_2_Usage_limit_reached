<nav class="sidebar" aria-label="Основная навигация">
  <div class="sidebar__top">
    <img class="sidebar__logo" src="/assets/sidebar/logo.svg" alt="" aria-hidden="true">
    <div class="sidebar__items">
      <button class="sidebar__item sidebar__item_type_search" type="button" aria-disabled="true" aria-label="Поиск" title="Будет доступно позже">
        <span class="sidebar__icon sidebar__icon_type_search" aria-hidden="true"></span>
      </button>
      <button class="sidebar__item sidebar__item_type_notification" type="button" aria-disabled="true" aria-label="Уведомления" title="Будет доступно позже">
        <span class="sidebar__icon sidebar__icon_type_notification" aria-hidden="true"></span>
      </button>
      <button class="sidebar__item sidebar__item_type_subscribes" type="button" aria-disabled="true" aria-label="Подписки" title="Будет доступно позже">
        <span class="sidebar__icon sidebar__icon_type_subscribes" aria-hidden="true"></span>
      </button>
    </div>
  </div>
  <div class="sidebar__bottom">
    <button class="sidebar__item sidebar__item_type_profile" type="button" aria-label="Профиль" aria-haspopup="menu" aria-expanded="false" aria-controls="profile-menu">
