<dialog class="modal{{#if className}} {{className}}{{/if}}" aria-labelledby="{{id}}-title">
  <div class="modal__window">
    <div class="modal__header">
      <h2 class="modal__title" id="{{id}}-title">{{title}}</h2>
      <button class="modal__close" type="button" aria-label="Закрыть" data-modal-close></button>
    </div>
    {{> @partial-block}}
  </div>
</dialog>
