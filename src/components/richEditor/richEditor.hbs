<div class="rich-editor">
  <div class="rich-editor__toolbar" role="toolbar" aria-label="Форматирование текста" aria-controls="{{id}}">
    <div class="action-menu rich-editor__block">
      <button class="action-menu__button rich-editor__block-button" type="button" aria-haspopup="menu" aria-expanded="false" aria-controls="{{id}}-blocks" data-block-label>Обычный текст</button>
      <div class="action-menu__list rich-editor__block-list" id="{{id}}-blocks" role="menu" aria-label="Тип текста" hidden>
        <button class="action-menu__item rich-editor__block-option" type="button" role="menuitemradio" aria-checked="true" tabindex="-1" data-action="p">Обычный текст</button>
        <button class="action-menu__item rich-editor__block-option rich-editor__block-option_type_heading" type="button" role="menuitemradio" aria-checked="false" tabindex="-1" data-action="h3">Подзаголовок</button>
      </div>
    </div>
    <span class="rich-editor__separator" aria-hidden="true"></span>
    <button class="rich-editor__tool rich-editor__tool_type_bold" type="button" aria-label="Жирный" aria-pressed="false" data-command="bold"></button>
    <button class="rich-editor__tool rich-editor__tool_type_italic" type="button" aria-label="Курсив" aria-pressed="false" data-command="italic"></button>
    <button class="rich-editor__tool rich-editor__tool_type_underline" type="button" aria-label="Подчёркнутый" aria-pressed="false" data-command="underline"></button>
    <button class="rich-editor__tool rich-editor__tool_type_strikethrough" type="button" aria-label="Зачёркнутый" aria-pressed="false" data-command="strikeThrough"></button>
    <span class="rich-editor__separator" aria-hidden="true"></span>
    <button class="rich-editor__tool rich-editor__tool_type_list-bullet" type="button" aria-label="Маркированный список" aria-pressed="false" data-command="insertUnorderedList"></button>
    <button class="rich-editor__tool rich-editor__tool_type_list-numbered" type="button" aria-label="Нумерованный список" aria-pressed="false" data-command="insertOrderedList"></button>
    <span class="rich-editor__separator" aria-hidden="true"></span>
    <button class="rich-editor__tool rich-editor__tool_type_link" type="button" aria-label="Добавить ссылку" data-link-button></button>
  </div>
  <div
    class="rich-text rich-editor__content"
    id="{{id}}"
    contenteditable="true"
    role="textbox"
    aria-multiline="true"
    aria-label="{{label}}"
    aria-describedby="{{id}}-error"
    data-placeholder="{{placeholder}}"
    {{#if errorPlaceholder}}data-error-placeholder="{{errorPlaceholder}}"{{/if}}
    data-empty
  ></div>
  <input type="hidden" name="{{name}}" data-rich-editor-value>
  <p class="form-field__error rich-editor__error" id="{{id}}-error" data-error-for="{{name}}" aria-live="polite"></p>
</div>
