<div class="avatar-cropper">
  <canvas class="avatar-cropper__canvas" width="464" height="288" role="img" aria-label="Перетащите фото, чтобы выбрать область"></canvas>
  <div class="avatar-cropper__zoom">
    <button class="avatar-cropper__step avatar-cropper__step-out" type="button" aria-label="Уменьшить" data-zoom-out></button>
    <input class="avatar-cropper__range" type="range" min="1" max="3" step="0.01" value="1" aria-label="Масштаб">
    <button class="avatar-cropper__step avatar-cropper__step-in" type="button" aria-label="Увеличить" data-zoom-in></button>
  </div>
</div>
