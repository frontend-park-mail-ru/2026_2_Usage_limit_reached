{{#if items}}
  <ul class="admin__list">
    {{#each items}}
      <li{{#if ../editable}} class="admin__config-row"{{/if}}>
        <span>{{name}}</span>
        {{#if ../editable}}
          <button
            class="button button_view_secondary"
            type="button"
            data-edit-config="{{name}}"
            aria-label="Редактировать конфиг {{name}}"
          >Редактировать</button>
        {{/if}}
      </li>
    {{/each}}
  </ul>
{{else}}
  <p class="admin__list-message">{{#if message}}{{message}}{{else}}Ничего не найдено{{/if}}</p>
  {{#if retry}}
    <button class="button button_view_secondary" type="button" data-list-retry>Повторить</button>
  {{/if}}
{{/if}}
